# ─────────────────────────────────────────────────────────────────────────────
# Dalali Trust — environment variables. Copy to `.env` and fill in.
# NEVER commit real secrets. `.env` is git-ignored.
# ─────────────────────────────────────────────────────────────────────────────

# PostgreSQL (required). Matches docker-compose.yml for local development.
DATABASE_URL="postgresql://dalali:dalali_dev_password@localhost:5432/dalali_trust?schema=public"

# Separate databases used ONLY by automated tests (they are truncated on every run).
TEST_DATABASE_URL="postgresql://dalali:dalali_dev_password@localhost:5432/dalali_trust_test?schema=public"
E2E_DATABASE_URL="postgresql://dalali:dalali_dev_password@localhost:5432/dalali_trust_e2e?schema=public"

# Authentication (required). At least 32 random characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET="replace-with-a-long-random-secret"
# Public URL of the site (used for auth callbacks, password-reset links and CSRF origin checks).
BETTER_AUTH_URL="http://localhost:3000"
APP_URL="http://localhost:3000"

# Set to "true" only when running behind a trusted reverse proxy / load balancer that
# sets X-Forwarded-For (used for rate limiting). Leave "false" otherwise.
TRUST_PROXY_HEADERS="false"
# Optional: one header your hosting edge sets itself with the visitor IP (preferred over
# X-Forwarded-For, which visitors can add to). Render/Cloudflare: "cf-connecting-ip".
CLIENT_IP_HEADER=""

# Private file storage for photos and verification documents.
#   local: files under STORAGE_LOCAL_DIR (outside /public). Development / single server only.
#   s3:    any S3-compatible PRIVATE bucket (AWS S3, Cloudflare R2, Backblaze B2, MinIO).
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./storage"
# S3_BUCKET=""
# S3_REGION=""                 # e.g. "af-south-1" or "auto" for R2
# S3_ENDPOINT=""               # required for non-AWS providers
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_FORCE_PATH_STYLE="false"  # "true" for MinIO

# Transactional email (password reset).
#   none:    disabled — the UI says reset by email is unavailable (never claims an email was sent)
#   console: development only — prints emails to the server log (rejected in production)
#   resend:  https://resend.com — requires RESEND_API_KEY and EMAIL_FROM
EMAIL_PROVIDER="console"

# WhatsApp updates (viewing requests, listing reviews) through Meta's WhatsApp Business
# Platform. "none" = off (default), "console" = print messages to the log (development),
# "cloud" = send real messages. See docs/WHATSAPP.md for the one-time Meta setup.
WHATSAPP_PROVIDER="console"
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_API_VERSION="v21.0"
# EMAIL_FROM="Dalali Trust <no-reply@your-domain.example>"
# RESEND_API_KEY=""

# Support contact details shown on the Contact page (optional). Phones in E.164 format.
# SUPPORT_EMAIL="support@your-domain.example"
# SUPPORT_PHONE="+2557XXXXXXXX"
# SUPPORT_WHATSAPP="+2557XXXXXXXX"

# Trust & retention policy (optional; defaults shown).
# VERIFICATION_VALIDITY_DAYS="365"   # verified checks expire after this many days
# EVIDENCE_RETENTION_DAYS="180"      # documents are deleted this long after a decision
# AVAILABILITY_STALE_DAYS="30"       # listings unconfirmed for longer show a warning

# Development seed only (optional).
# SEED_PASSWORD="dalali-dev-password"
