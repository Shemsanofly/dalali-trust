# ── Africa's Talking ──────────────────────────────────────────────────────
AT_API_KEY=your_at_api_key_here
AT_USERNAME=sandbox
AT_SENDER_ID=KibandaShr
AT_VOICE_NUMBER=+254711XXXXXX
AT_PRODUCT_NAME=KibandaSharePay

# ── OpenAI ────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...your_key_here
