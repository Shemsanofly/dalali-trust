{
    "version": 2,
    "buildCommand": "cd client && npm install && npm run build",
    "outputDirectory": "client/dist",
    "installCommand": "npm install && cd client && npm install",
    "framework": null,
    "functions": {
        "api/index.js": {
            "maxDuration": 30
        }
    },
    "rewrites": [
        {
            "source": "/api/(.*)",
            "destination": "/api"
        },
        {
            "source": "/ussd(.*)",
            "destination": "/api"
        },
        {
            "source": "/payments(.*)",
            "destination": "/api"
        },
        {
            "source": "/voice(.*)",
            "destination": "/api"
        },
        {
            "source": "/voicebot(.*)",
            "destination": "/api"
        },
        {
            "source": "/((?!api|ussd|payments|voice|voicebot).*)",
            "destination": "/index.html"
        }
    ]
}