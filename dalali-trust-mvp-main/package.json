{
  "name": "dalali-trust",
  "version": "0.1.0",
  "private": true,
  "description": "Dalali Trust — transparent, accountable rental property discovery and verification for Tanzania",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset",
    "admin:promote": "tsx scripts/promote-admin.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "jobs:expire-verifications": "tsx --conditions=react-server scripts/expire-verifications.ts",
    "jobs:admin-digest": "tsx --conditions=react-server scripts/admin-digest.ts",
    "jobs:send-whatsapp": "tsx --conditions=react-server scripts/send-whatsapp.ts",
    "jobs:send-sms": "tsx --conditions=react-server scripts/send-sms.ts",
    "sms:test": "tsx --conditions=react-server scripts/send-test-sms.ts",
    "legacy:export": "tsx scripts/export-legacy-mongo.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1150.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "better-auth": "1.7.7",
    "dotenv": "16.6.1",
    "lucide-react": "1.56.0",
    "next": "16.4.0",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "zod": "4.3.3"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.0",
    "prettier": "3.9.10",
    "prisma": "7.10.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.4"
  },
  "overrides": {
    "mysql2": "3.24.5",
    "deepmerge-ts": "8.0.2"
  }
}
